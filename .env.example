# Copy to .env and adjust. .env is gitignored; never commit real secrets.
#
# Nothing in here is secret any more. The API holds no accounts, no sessions
# and no database, so there is no signing key to protect and no credentials to
# rotate. That is the whole point of the design rather than an omission.

# --- API ------------------------------------------------------------------
# Where uploaded images are written. In compose this is the shared volume.
MEDIA_ROOT=/var/www/static
MEDIA_URL=/media/

# Exports written by `cxr export`. An empty or missing directory is not a
# startup failure: /health reports inference_available=false and /predict
# answers 503.
MODEL_DIR=/var/www/models

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Largest upload accepted, in bytes. Default is 20 MB.
# MAX_UPLOAD_BYTES=20971520

# --- Frontend -------------------------------------------------------------
# Where Vite's dev proxy forwards /api and /media.
VITE_PROXY_TARGET=http://backend-xrays:3080
