# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# --- Django ---------------------------------------------------------------
# Leave DJANGO_SECRET_KEY empty for local development and the app generates an
# ephemeral one per process. It is required whenever DJANGO_DEBUG is off.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend-xrays
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_LOG_LEVEL=INFO

# TLS hardening. Defaults follow DJANGO_DEBUG; override only if you terminate
# TLS somewhere the app cannot see.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_COOKIES=true
# DJANGO_HSTS_SECONDS=31536000

# Where uploaded images are written. In compose this is the shared volume.
DJANGO_MEDIA_ROOT=/var/www/static

# SQLite path. Phase B replaces this with the Postgres service.
# DJANGO_DB_PATH=/var/www/app/backend/db.sqlite3

# --- Frontend -------------------------------------------------------------
# Where Vite's dev proxy forwards /api and /media.
VITE_PROXY_TARGET=http://backend-xrays:3080
