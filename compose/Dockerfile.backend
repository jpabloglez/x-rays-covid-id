FROM python:3.11-slim
ARG PIP_ARGS=
ENV PYTHONUNBUFFERED 1

WORKDIR /var/www/app

# Requirements have to be pulled and installed here, otherwise caching won't work
# The ml package is installed from source (-e ./ml in requirements), so it
# has to be present before pip runs.
COPY ./setup/requirements.txt /var/www/app/requirements.txt
COPY ./ml /var/www/app/ml

RUN pip install -U pip
RUN pip install --no-cache-dir -r requirements.txt

# The application source. Compose overrides this directory with a bind mount
# for local hot-reload, so this COPY was never exercised there and the image
# built successfully with an empty api/ -- it only ran because the host
# directory was always present to paper over it. Any environment without that
# exact bind mount (a plain `docker run`, a registry pull, a real deployment)
# got `ModuleNotFoundError: No module named 'api'` at container start.
COPY ./app/backend /var/www/app/backend

# Change www-data user to match the host system UID and GID, and chown the
# image's own copy of /var/www. This never touches a volume mounted at runtime
# -- docker-entrypoint.sh handles that, on every boot, because a volume that
# already existed before this chown ran keeps whatever ownership it had.
RUN usermod --non-unique --uid 1000 www-data \
  && groupmod --non-unique --gid 1000 www-data \
  && chown -R www-data:www-data /var/www

# gosu, not `su`: dropping from root to www-data after the entrypoint's chown
# needs to replace the process and forward signals correctly (so a container
# stop actually reaches uvicorn), which is exactly what gosu exists for and
# `su -c` is known to get subtly wrong.
RUN apt-get update \
  && apt-get install -y --no-install-recommends gosu \
  && rm -rf /var/lib/apt/lists/*

COPY ./compose/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# No USER directive: the entrypoint starts as root on purpose, to fix a stale
# volume's ownership, and drops to www-data itself before anything else runs.

WORKDIR /var/www/app/backend

EXPOSE 3080

ENTRYPOINT ["docker-entrypoint.sh"]

# uvicorn, not manage.py: the HTTP surface is FastAPI as of XRAYS-09.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "3080"]
