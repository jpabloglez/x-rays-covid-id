FROM node:20-slim

# Dependencies live one level above the app directory so that the bind mount
# compose places on /var/www/app/frontend does not shadow node_modules.
WORKDIR /var/www/app

COPY ./app/frontend/package.json ./app/frontend/package-lock.json ./

RUN npm ci

ENV PATH=/var/www/app/node_modules/.bin:$PATH

COPY ./app/frontend/ /var/www/app/frontend/

WORKDIR /var/www/app/frontend

# The node images already ship a uid/gid 1000 "node" user; match the host.
RUN chown -R node:node /var/www

USER node

EXPOSE 3000

CMD ["npm", "run", "dev"]
